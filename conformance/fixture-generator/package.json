{
    "name": "rust-gateway-conformance-fixture-generator",
    "version": "0.0.0",
    "private": true,
    "description": "Generates the OpenAPI fixtures in ../fixtures from a NestJS service decorated with @hodfords/nestjs-api-gateway-client.",
    "license": "MIT",
    "type": "module",
    "packageManager": "pnpm@12.1.0",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "generate": "tsc -p tsconfig.json && node dist/generate.js ../fixtures"
    },
    "dependencies": {
        "@hodfords/nestjs-api-gateway-client": "12.0.0",
        "@nestjs/common": "12.1.3",
        "@nestjs/core": "12.1.3",
        "@nestjs/platform-express": "12.1.3",
        "@nestjs/swagger": "12.0.2",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2"
    },
    "devDependencies": {
        "@types/node": "26.4.0",
        "typescript": "6.0.3"
    }
}
